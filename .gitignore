# Secrets live in .env only. Never commit the key.
.env
# Local state
*.sqlite
*.sqlite-journal
reports/*.html
__pycache__/
*.pyc
.pytest_cache/
# b2c-openapi.yaml is committed on purpose: the scheduled workflow reads it. The repo is private.
.env*
!env.example
.venv/
history/

# AFL: data lives on the afl-history release, never in the repo
afl/cache/

# NBL: data lives on the nbl-history release, never in the repo
nbl/cache/
nbl/out/
nbl/sheets/

# Greyhounds: Topaz files live on the greyhound-history release, never in the repo
greyhound/cache/
data/greyhound/
