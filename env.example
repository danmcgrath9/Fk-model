# Copy to .env (the root .gitignore of this repo ignores every .env* file, which is why this is env.example).
FK_API_KEY=your_key_here
# Path to the Form King OpenAPI spec (version 1.0.8). Defaults to ./b2c-openapi.yaml
FK_SPEC_PATH=b2c-openapi.yaml
# Optional: override the server URL in the spec.
# FK_BASE_URL=https://...
# Supabase Postgres connection string (Settings > Database > Connection string, URI).
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
# Where the credit ledger lives.
FK_LEDGER_PATH=credits.sqlite
# Monthly allowance on Single State Pro.
FK_MONTHLY_CREDITS=20000
